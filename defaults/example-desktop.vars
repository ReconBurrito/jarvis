# Answers for an unattended install of the Jarvis desktop container:
#
#   JARVIS_ANSWERS=/root/jarvis-desktop.vars bash -c "$(curl -fsSL https://raw.githubusercontent.com/ReconBurrito/jarvis/main/ct/jarvis-desktop.sh)"
#
# The rules are those of defaults/example.vars; only what differs for the desktop is explained here.
# The addresses below are documentation examples.

var_ctid=201
var_hostname=jarvis-desktop
var_container_storage=local-lvm
var_template_storage=local
var_disk=32
var_cpu=4
var_ram=3072
var_swap=512

var_brg=vmbr0
var_vlan=100
var_mac=00:00:5E:00:53:C9
var_net=dhcp
var_expect_ip=192.0.2.201

# The render device of the GPU that draws the desktop and encodes the picture it sends, or none.
var_gpu=/dev/dri/renderD128
var_timezone=Europe/London
var_onboot=yes

# The desktop has no sign-in of its own. It is meant to stand behind a reverse proxy that asks who you
# are, and a firewall in the container lets in nobody else.
# Who may open it: the address of that reverse proxy. Several addresses or networks (192.0.2.0/28) go
# on one line with commas between. Left out, nobody can open the desktop.
var_desktop_allow=192.0.2.7
# The web address you open the desktop at, as your browser shows it (no trailing slash; a port only if
# it is not 443). A page from another web address is then refused when it tries to connect.
var_desktop_origin=https://desktop.example.org

# The container ID of the Jarvis brain on this node. The installer reads the brain's address and its
# certificate authority from that container and hands them to the desktop, whose browser then trusts the
# brain for that one address. The brain must name this desktop's address in var_panel_allow. Left out,
# the panel stays a placeholder; add it later and run the installer again.
var_brain=200

var_release=signed
