# Answers for an unattended install of the Jarvis brain container:
#
#   JARVIS_ANSWERS=/root/jarvis.vars bash -c "$(curl -fsSL https://raw.githubusercontent.com/ReconBurrito/jarvis/main/ct/jarvis.sh)"
#
# Every line is var_name=value. A setting left out keeps its default; a name the installer does not know
# stops it before anything is changed. The same names work as environment variables and win over this file.
# Keep your own copy outside this repository: it describes your network. It holds no passwords or keys.
# The addresses below are documentation examples.

# The container ID must be named here, so that a second run finds the container of the first.
var_ctid=200
var_hostname=jarvis
var_container_storage=local-lvm
var_template_storage=local
var_disk=48
var_cpu=6
var_ram=6144
var_swap=0

var_brg=vmbr0
# VLAN tag, and a fixed MAC address so a DHCP reservation always matches. Leave both out for none.
var_vlan=100
var_mac=00:00:5E:00:53:C8
# dhcp, or a fixed address with its gateway:
#   var_net=192.0.2.200/24
#   var_gateway=192.0.2.1
var_net=dhcp
# With dhcp: stop if the container is handed any other address than this one.
var_expect_ip=192.0.2.200

# The render device of the GPU that runs the local model, or none. var_gpu_gid is the number of the render
# group inside the container; the installer corrects it after the first start, so it rarely needs naming.
var_gpu=/dev/dri/renderD128
#   var_gpu_gid=993
# host, UTC, or a zone name.
var_timezone=Europe/London
var_onboot=yes
#   var_tags=jarvis
# Install although the node has less memory available than var_ram:
#   var_allow_low_memory=no

# Where Jarvis keeps its .env files (a new or empty folder under /etc/jarvis/, /srv/, /opt/, /mnt/ or
# /media/), and how: plain (root and jarvis only) or sops (encrypted with age).
var_env_dir=/etc/jarvis/secrets
var_secrets=plain

# The local model Jarvis thinks with and the one for searching notes by meaning, as Ollama names them
# (ollama.com/library), fetched at install; none goes without. Several GB each.
var_model=qwen3:8b
#   var_embed_model=qwen3-embedding:0.6b

# Who may reach Jarvis's panel port (8443): the address of the desktop container. Several addresses or
# networks (192.0.2.0/28) go on one line with commas between. Left out, nobody can; add it later and run
# the installer again. The desktop is then given this container's ID as var_brain.
var_panel_allow=192.0.2.201

# signed: only releases signed by a key pinned at install. branch: follow var_branch unchecked (development).
var_release=signed
#   var_branch=main
# The repository the container installs from:
#   var_repo=ReconBurrito/jarvis
